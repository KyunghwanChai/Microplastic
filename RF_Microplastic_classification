clear; clc; close all;

%% 1. Load Data
filename = "Microplastic.csv";
tbl = readtable(filename);

featureVarNames = tbl.Properties.VariableNames(1:end-2);
sampleVarName   = tbl.Properties.VariableNames{end-1};
labelVarName    = tbl.Properties.VariableNames{end};

X_raw     = tbl{:, featureVarNames};
sampleIDs = tbl{:, sampleVarName};
Y         = tbl{:, labelVarName};

if iscell(Y) || iscategorical(Y)
    Y = grp2idx(Y);
end
Y = categorical(Y);

%% 2. Sample-level K-Fold Split
K = 5;
uniqueSamples = unique(sampleIDs);
numSamples    = numel(uniqueSamples);

rng(1);
shuffledIdx = randperm(numSamples);
foldSize    = floor(numSamples / K);

testAcc_all    = zeros(K, 1);
all_Y_test     = [];
all_YPred_test = [];

%% 3. K-Fold Loop
for k = 1:K
    fprintf('\n================ Fold %d ================\n', k);

    if k < K
        testSamples = uniqueSamples(shuffledIdx((k-1)*foldSize+1 : k*foldSize));
    else
        testSamples = uniqueSamples(shuffledIdx((k-1)*foldSize+1 : end));
    end

    trainSamples = setdiff(uniqueSamples, testSamples);

    %% 4. Train / Test Split
    train_mask = ismember(sampleIDs, trainSamples);
    test_mask  = ismember(sampleIDs, testSamples);

    X_train_raw = X_raw(train_mask, :);
    Y_train     = Y(train_mask);

    X_test_raw  = X_raw(test_mask, :);
    Y_test      = Y(test_mask);

    %% 5. Baseline Correction
    window     = 50;
    X_train_bc = X_train_raw - movmean(X_train_raw, window, 2);
    X_test_bc  = X_test_raw  - movmean(X_test_raw,  window, 2);

    %% 6. SERS Preprocessing
    X_train_proc = log1p(sgolayfilt(X_train_bc, 3, 11));
    X_test_proc  = log1p(sgolayfilt(X_test_bc,  3, 11));

    %% 7. Normalization
    [X_train_final, mu, sigma] = zscore(X_train_proc);
    sigma(sigma == 0) = 1;
    X_test_final = (X_test_proc - mu) ./ sigma;

    %% 8. Train Random Forest
    rfModel = TreeBagger(100, X_train_final, Y_train, ...
        'Method',                  'classification', ...
        'MinLeafSize',             2, ...
        'OOBPrediction',           'on', ...
        'OOBPredictorImportance',  'on');

    %% 9. Evaluation
    [YPred_cell, ~] = predict(rfModel, X_test_final);
    YPred_test      = categorical(YPred_cell);

    acc = mean(YPred_test == Y_test) * 100;
    fprintf('Fold %d Test Accuracy: %.2f%%\n', k, acc);
    fprintf('Fold %d OOB Error (final): %.4f\n', k, oobError(rfModel, 'Mode', 'ensemble'));
    testAcc_all(k) = acc;

    figure;
    confusionchart(Y_test, YPred_test);
    title(sprintf('Fold %d Confusion Matrix', k));

    all_Y_test     = [all_Y_test;     Y_test];
    all_YPred_test = [all_YPred_test; YPred_test];
end

%% 10. Final Results
fprintf('\n================ Results ================\n');
fprintf('Mean Accuracy : %.2f%%\n', mean(testAcc_all));
fprintf('Std Deviation : %.2f%%\n', std(testAcc_all));

figure;
confusionchart(all_Y_test, all_YPred_test);
title('Overall Confusion Matrix (K-Fold)');
